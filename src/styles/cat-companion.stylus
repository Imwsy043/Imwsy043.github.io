.cat-companion
  position: fixed
  top: 0
  left: 0
  width: 46px
  height: 46px
  opacity: 0
  pointer-events: none
  user-select: none
  z-index: 850
  will-change: transform, opacity
  transition: opacity 0.2s ease

  &.is-visible
    opacity: 0.88

  img
    width: 100%
    height: 100%
    display: block
    object-fit: contain
    filter: drop-shadow(0 4px 8px rgba(28, 43, 61, 0.18))

[data-theme='dark'] .cat-companion img
  filter: invert(1) brightness(1.1) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3)) !important

@media (pointer: coarse), screen and (max-width: 767px)
  .cat-companion
    display: none
