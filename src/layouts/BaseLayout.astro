---
import "../styles/global.css";
import "@reimujs/aos/dist/aos.css";

import { ClientRouter } from "astro:transitions";

import {
  BANNER,
  HOME_BANNER_SLIDESHOW,
  PRELOADER,
  SITE,
  SIDEBAR,
} from "../utils/config";
import { MUSIC_TRACKS } from "../data/music";
import { urlFor } from "../utils/urlFor";
import CommonMeta from "../components/partial/CommonMeta.astro";
import VendorScript from "../components/partial/VendorScript.astro";
import ThemeScript from "../components/partial/ThemeScript.astro";
import Header from "../components/Header.astro";
import AfterFooter from "../components/AfterFooter.astro";
import MusicPlayer from "../components/partial/MusicPlayer";
import CatCompanion from "../components/partial/CatCompanion";
import Loader from "../components/partial/Loader.astro";
import Sidebar from "../components/Sidebar.astro";
import MobileNav from "../components/MobileNav.astro";
import SidebarScript from "../components/sidebar/SidebarScript.astro";

type Props = {
  title?: string;
  description?: string;
  cover?: string;
  keywords?: string | string[];
  isPost?: boolean;
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
  toc?: boolean;
  homeHeader?: boolean;
};

const {
  title = SITE.title,
  description = SITE.description,
  cover,
  keywords = SITE.keywords,
  isPost = false,
  headings = [],
  toc = true,
  homeHeader = false,
} = Astro.props;

const homeSlides = homeHeader && HOME_BANNER_SLIDESHOW.enable
  ? HOME_BANNER_SLIDESHOW.images
  : [];
const headerImage = cover || homeSlides[0] || BANNER;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <ThemeScript />
    <CommonMeta title={title} description={description} keywords={keywords} />
    <link rel="preload" as="image" href={urlFor(headerImage)} />
    <style>
      main {
        position: relative;
        display: flex;
        padding-top: 8px;
        align-items: stretch;
        max-width: 1550px;
        margin: 0 auto;
        overflow: visible;
      }
    </style>
    <VendorScript />
    <ClientRouter />
  </head>
  <body>
    {PRELOADER.enable && <Loader />}
    <Header
      cover={cover}
      slides={homeSlides}
      slideInterval={HOME_BANNER_SLIDESHOW.interval}
    >
      <slot name="header" />
    </Header>

    <main
      class={SIDEBAR.position === "left"
        ? "sidebar-left"
        : SIDEBAR.position === "right"
          ? "sidebar-right"
          : ""}
    >
      {
        SIDEBAR.position === "left" && (
          <Sidebar isPost={isPost} headings={headings} toc={toc} />
        )
      }
      <slot />
      {
        SIDEBAR.position === "right" && (
          <Sidebar isPost={isPost} headings={headings} toc={toc} />
        )
      }
    </main>
    <slot name="footer" />
    <AfterFooter />
    <MusicPlayer
      client:load
      transition:persist
      imageUrl={urlFor("images/cat-music.png")}
      requestUrl="https://github.com/Imwsy043/Imwsy043.github.io/issues/new"
      tracks={MUSIC_TRACKS}
    />
    <CatCompanion
      client:load
      transition:persist
      imageUrl={urlFor("images/cat-companion.png")}
    />
    <MobileNav isPost={isPost} headings={headings} toc={toc} />
    <div id="mask" class="hide"></div>
    <SidebarScript />
  </body>
</html>
