---
import { Icon } from "astro-icon/components";

import { __ } from "../utils/i18n";
import {
  MENU,
  TRIANGLE_BADGE,
} from "../utils/config";
import { urlFor } from "../utils/urlFor";

import HeaderLink from "./partial/HeaderLink.astro";
import RssBtn from "./partial/RssBtn";
import SearchBtn from "./partial/SearchBtn";
import ThemeBtn from "./partial/ThemeBtn";
import SearchBox from "./partial/SearchBox";
import HeaderBackdrop from "./partial/HeaderBackdrop.astro";

type Props = {
  cover?: string;
  slides?: string[];
  slideInterval?: number;
};

const {
  cover,
  slides = [],
  slideInterval = 6000,
} = Astro.props;
const isHomeHero = !cover && slides.length > 0;
---

<div id="header-nav">
  <nav id="main-nav">
    {
      MENU.map((item) => (
        <HeaderLink href={urlFor(item.url)} aria-label={item.name}>
          {__(item.name)}
        </HeaderLink>
      ))
    }
    <span
      id="main-nav-toggle"
      class="nav-icon"
      aria-label="Toggle navigation"
      role="button"
    >
      <Icon name="fa6-solid:bars" size={14} />
    </span>
  </nav>
  <nav id="sub-nav" aria-label="Secondary navigation">
    <RssBtn client:load href={urlFor("rss.xml")} className="nav-icon" />
    <SearchBtn client:load className="nav-icon" />
    <ThemeBtn client:load className="nav-icon" />
  </nav>
  {
    TRIANGLE_BADGE.enable && (
      <a
        href={TRIANGLE_BADGE.link}
        class="triangle-badge"
        title={TRIANGLE_BADGE.type}
        target="_blank"
        rel="noopener nofollow noreferrer"
      >
        <Icon
          name={`fa6-brands:${TRIANGLE_BADGE.type}`}
          class="triangle-badge-icon"
        />
      </a>
    )
  }
</div>
<header id="header" class:list={{ "home-hero": isHomeHero }}>
  <HeaderBackdrop
    cover={cover}
    slides={slides}
    interval={slideInterval}
  />
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <slot />
    </div>
  </div>
</header>
<SearchBox
  client:idle
  searchIndexUrl={urlFor("search.json")}
  postUrlPrefix={urlFor("blog")}
  imageUrl={urlFor("images/oc-moon.jpg")}
/>

<script>
  let oldScrollTop = 0;
  window.addEventListener("scroll", () => {
    let scrollTop =
      document.documentElement.scrollTop || document.body.scrollTop;
    let diffY = scrollTop - oldScrollTop;
    window.diffY = diffY;
    oldScrollTop = scrollTop;
    if (diffY < 0) {
      document
        .getElementById("header-nav")!
        .classList.remove("header-nav-hidden");
    } else {
      document.getElementById("header-nav")!.classList.add("header-nav-hidden");
    }
  });
</script>

<style lang="stylus">
  #header-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    background: var(--color-header-background);
    box-shadow: var(--shadow-card);
    transition: background 1s, top 0.3s;
    z-index: 200;
    &.header-nav-hidden {
      top: -80px;
    }
    &:hover {
      background: rgba(255, 255, 255, 0.95);
    }
  }

  #main-nav {
    display: flex;
    align-items: center;
  }

  #header {
    min-height: 400px;
    height: 35vh;
    position: relative;

    &.home-hero {
      --color-header-title: #f8fbff;
      --color-header-subtitle: #e9f3fb;
      --color-header-title-shadow: rgba(5, 13, 23, 0.86);
      height: 68vh;
      min-height: 540px;
      max-height: 760px;
      overflow: hidden;
      isolation: isolate;
    }

    @media screen and (max-width: 959px) {
      &.home-hero {
        height: 64vh;
        min-height: 500px;
      }
    }

    @media screen and (max-width: 767px) {
      &.home-hero {
        height: 62svh;
        min-height: 460px;
        max-height: 620px;
      }
    }

  }

  #header-outer {
    height: 100%;
    position: relative;
    max-width: 100%;
    z-index: 10;
  }


  #main-nav-toggle {
    display: none;

    @media screen and (max-width: 767px) {
      display: block;
    }
  }

  :global(.nav-icon) {
    color: var(--red-0);
    opacity: 0.8;
    text-decoration: none;
    transition: 0.2s;
    padding: 20px 15px;
    text-align: center;
    font-size: 14px;
    width: 14px;
    height: 14px;
    will-change: transform;
    cursor: pointer;

    &:hover {
      opacity: 1;
      transform: scale(1.1);
    }
  }

  :global(.theme-toggle) {
    appearance: none;
    width: 44px;
    height: 44px;
    padding: 0;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    line-height: 1;
    font-size: 20px;
    font-family: inherit;

    &:focus:not(:focus-visible) {
      outline: none;
    }

    &:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: 2px;
    }
  }

  :global(.theme-toggle svg) {
    width: 20px;
    height: 20px;
    display: block;
  }

  :global(.theme-sun) {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    line-height: 1;
  }

  :global([data-theme='dark']) {
    #header-nav:hover {
      background: var(--color-header-background);
    }

    :global(.nav-icon) {
      color: var(--red-2);
    }
  }

  #header-title {
    font-weight: 700;
    text-align: center;
    position: absolute;
    top: 50%;
    margin: 40px * -0.5 2.5% 0;
    width: 95%;
    opacity: 0;
    filter: blur(8px);
    will-change: transform, opacity, filter;
    animation: fade-in-blur 800ms ease-out 200ms forwards;
  }

  #sub-nav {
    display: flex;
    align-items: center;
  }

  @keyframes fade-in-blur {
    0% {
      opacity: 0;
      filter: blur(10px);
    }

    100% {
      opacity: 1;
      filter: blur(0);
    }
  }

  .triangle-badge {
    position: absolute;
    top: -6px;
    right: -26px;
    transform: rotate(45deg);
    width: 0;
    height: 0;
    border-left: 40px solid transparent;
    border-right: 40px solid transparent;
    border-bottom: 40px solid var(--red-2);
    display: inline-block;
    transition: 0.3s;

    @media screen and (max-width: 959px) {
      display: none;
    }
  }

  .triangle-badge-icon {
    position: absolute;
    top: 12px;
    left: -13px;
    color: var(--color-header-background) !important;
    font-size: 28px;
    transition: 0.3s;
  }
</style>
